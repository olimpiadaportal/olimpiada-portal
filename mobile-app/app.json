{
  "expo": {
    "name": "OlympIQ",
    "slug": "olympiq",
    "version": "1.10.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "olympiq",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "ai.olympiq.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSPhotoLibraryUsageDescription": "OlympIQ needs access to your photos so you can choose a profile picture for your account or for your child's profile.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.olympiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#141B4D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffbf5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#14101f"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#7c3aed"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OlympIQ istifadəçini təsdiqləmək üçün Face ID istifadə edir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "786a0358-d1db-437e-9fa3-b466b490a8ae"
      }
    },
    "owner": "olimpiadaplatforms-team",
    "updates": {
      "url": "https://u.expo.dev/786a0358-d1db-437e-9fa3-b466b490a8ae"
    }
  }
}
