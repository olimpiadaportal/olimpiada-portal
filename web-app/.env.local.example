# OlympIQ — Web App (Student/Parent) environment template.
# Copy this file to `.env.local` and fill with your Supabase DEV/STAGING values.
# Get these from: Supabase Dashboard -> Project Settings -> API.
#
# NEXT_PUBLIC_* values are sent to the browser. ONLY the project URL and the
# anon (public) key are safe to expose there.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public origin of THIS web app (no trailing slash) — the base for auth-email
# redirect links (signUp emailRedirectTo, password-recovery redirectTo →
# /auth/callback). Set to the deployed URL in production (e.g. the Vercel
# domain); falls back to http://localhost:3000 in dev when unset.
NEXT_PUBLIC_SITE_URL=

# SERVER-ONLY secret (NO NEXT_PUBLIC_ prefix → never sent to the browser).
# Used only by server code (Server Actions / Route Handlers) for privileged
# operations RLS forbids to normal users: child account provisioning, child
# password reset, and login-lockout bookkeeping. It is read exclusively by
# `src/lib/supabase/admin.ts`, which is marked `import "server-only"` so the
# build fails if it is ever pulled into client/browser code. Never log or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Notifications (optional; the in-app center works WITHOUT any of these) ----
# Shared secret guarding the delivery processor route (POST /api/notifications/
# process, header `x-processor-key`). Set it + point a scheduler (pg_cron+pg_net
# or an external cron) at the route ONLY when you enable email/push. Server-only.
NOTIFICATIONS_PROCESSOR_KEY=
# NOTE: email delivery now runs through the Brevo block below, not through this
# legacy variable. Kept only so an existing .env.local does not look broken.
NOTIFICATIONS_SMTP_URL=
# Push channel (Expo push delivery; enable `notifications_push` AND set this):
EXPO_ACCESS_TOKEN=
# Vercel Cron auth: Vercel calls GET /api/notifications/process with
# `Authorization: Bearer ${CRON_SECRET}` on the vercel.json schedule. Server-only.
CRON_SECRET=

# --- Transactional mail (Brevo) -----------------------------------------------
# ALL SERVER-ONLY secrets (NO NEXT_PUBLIC_ prefix -> never sent to the browser).
# They are read only by `src/lib/mail/brevo.ts`, which is marked
# `import "server-only"` so the build fails if it is ever pulled into client code.
#
# This is the transport behind the notification EMAIL channel
# (src/lib/notifications/delivery.ts). It degrades gracefully: a missing value
# means the send is skipped and a short reason is logged, never an exception.
# The channel additionally stays dormant while the `notifications_email` feature
# flag is off, which it is by default.
#
# Brevo transactional API key (sent as the `api-key` header). Empty = mail off.
BREVO_API_KEY=
# The VERIFIED sender address in your Brevo account. Empty = mail off.
BREVO_SENDER_EMAIL=
# Display name on outgoing mail. Empty = "OlympIQ".
BREVO_SENDER_NAME=

# --- Payments: AzeriCard / ABB e-commerce gateway --------------------------------
# ALL SERVER-ONLY (no NEXT_PUBLIC_ prefix -> never sent to the browser). Read
# ONLY by `src/lib/payments/azericard/config.ts`, which is `import "server-only"`
# so the build fails if it is ever pulled into client code. Never log or commit
# any of these, and never put a card number anywhere near this integration: the
# cardholder types the PAN on the bank's own hosted page after a FULL HTTP
# REDIRECT, which is what keeps us on PCI DSS SAQ A.
#
# Bank-assigned merchant terminal id (exactly 8 digits).
AZERICARD_TERMINAL=
# e-Commerce gateway endpoint. Authorisation, completion, reversal AND the
# TRTYPE=90 status query are all POSTed here.
#   sandbox:    https://testmpi.3dsecure.az/cgi-bin/cgi_link
#   production: https://mpi.3dsecure.az/cgi-bin/cgi_link
# NOTE: whatever host you use must also be in the CSP `form-action` list in
# next.config.mjs — the checkout redirect is a form POST to that origin.
AZERICARD_GATEWAY_URL=
# Card-storage endpoint. CARRIED BUT UNUSED: card-on-file / recurring is not
# approved for this merchant yet, and a dormant token path is exactly the kind
# of unused money surface that should not exist. Leave it set; nothing reads it.
#   sandbox:    https://testmpi.3dsecure.az/token/cgi_link
AZERICARD_TOKEN_URL=
# Our public site URL. Sent as MERCH_URL and covered by the authorisation MAC,
# so it must match byte for byte between the request and the signature.
AZERICARD_MERCHANT_URL=https://olympiq.ai
# Merchant name as the cardholder should recognise it on the bank's page.
AZERICARD_MERCHANT_NAME=OlympIQ
# ISO-4217 (3 uppercase letters) and ISO-3166-1 alpha-2 (2 uppercase letters).
AZERICARD_CURRENCY=AZN
AZERICARD_COUNTRY=AZ
# OUR RSA-2048 private key, base64-encoded. Signs the P_SIGN on everything we
# send. Base64 because a raw PEM's newlines do not survive every env transport,
# and a mangled key fails as "invalid signature" with nothing to debug.
#   openssl genrsa -out merchant_private_key.pem 2048
#   base64 -w0 merchant_private_key.pem
AZERICARD_PRIVATE_KEY_B64=
# THEIR public key (AZERICARDpublic.pem), base64-encoded. Verifies the P_SIGN on
# callbacks. Supplied by the bank during integration.
AZERICARD_MPI_PUBLIC_KEY_B64=
# Absolute https URL the gateway POSTs the result to (BACKREF). Optional:
# defaults to ${NEXT_PUBLIC_SITE_URL}/api/payments/azericard/callback. Set it
# explicitly when testing through a tunnel, where the public hostname is not the
# app's own origin.
AZERICARD_BACKREF_URL=
# Merchant UTC offset (MERCH_GMT), e.g. "+4". Optional and OMITTED by default:
# the spec wants it only when the merchant system's zone differs from the
# gateway's, our TIMESTAMP is generated in GMT(0) as required, and the
# deployment runs in UTC. Set it only if the bank asks.
AZERICARD_MERCH_GMT=
# Fallback for a documented ambiguity in the spec, NOT a tuning knob. §8.1 lists
# TRAN_TRTYPE among the merchant-generated fields of a TRTYPE=90 status query,
# while §8.3's worked example computes the MAC without it. We follow the worked
# example. Set this to `true` ONLY if the live test returns an invalid-signature
# error on status queries; see MAC_FIELDS_STATUS in lib/payments/azericard/mac.ts.
AZERICARD_STATUS_MAC_INCLUDES_TRAN_TRTYPE=
# Shared secret guarding the OWNER-ONLY test-initiation route
# (/api/payments/azericard/test-initiate, `Authorization: Bearer <token>`).
# UNSET = the route is closed and answers 404, indistinguishable from a typo.
# It is never exposed to a parent or a child, and never to a client bundle.
#   openssl rand -hex 32
AZERICARD_TEST_TOKEN=
# Shared secret guarding the RECONCILIATION SWEEP
# (POST /api/payments/azericard/reconcile, header `x-reconcile-key`). The sweep
# asks the gateway TRTYPE=90 about payments whose callback never arrived and
# redeems them exactly as the callback would; the gateway answers for only 24
# HOURS, so point a scheduler at it every few minutes once payments go live.
# Vercel Cron may drive the same route with GET + `Authorization: Bearer
# ${CRON_SECRET}` instead. UNSET = that entrypoint is closed, never open.
#   openssl rand -hex 32
PAYMENTS_RECONCILE_KEY=
