# OlympIQ — Web App (Student/Parent) environment template.
# Copy this file to `.env.local` and fill with your Supabase DEV/STAGING values.
# Get these from: Supabase Dashboard -> Project Settings -> API.
#
# NEXT_PUBLIC_* values are sent to the browser. ONLY the project URL and the
# anon (public) key are safe to expose there.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public origin of THIS web app (no trailing slash) — the base for auth-email
# redirect links (signUp emailRedirectTo, password-recovery redirectTo →
# /auth/callback). Set to the deployed URL in production (e.g. the Vercel
# domain); falls back to http://localhost:3000 in dev when unset.
NEXT_PUBLIC_SITE_URL=

# SERVER-ONLY secret (NO NEXT_PUBLIC_ prefix → never sent to the browser).
# Used only by server code (Server Actions / Route Handlers) for privileged
# operations RLS forbids to normal users: child account provisioning, child
# password reset, and login-lockout bookkeeping. It is read exclusively by
# `src/lib/supabase/admin.ts`, which is marked `import "server-only"` so the
# build fails if it is ever pulled into client/browser code. Never log or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Notifications (optional; the in-app center works WITHOUT any of these) ----
# Shared secret guarding the delivery processor route (POST /api/notifications/
# process, header `x-processor-key`). Set it + point a scheduler (pg_cron+pg_net
# or an external cron) at the route ONLY when you enable email/push. Server-only.
NOTIFICATIONS_PROCESSOR_KEY=
# NOTE: email delivery now runs through the Brevo block below, not through this
# legacy variable. Kept only so an existing .env.local does not look broken.
NOTIFICATIONS_SMTP_URL=
# Push channel (Expo push delivery; enable `notifications_push` AND set this):
EXPO_ACCESS_TOKEN=
# Vercel Cron auth: Vercel calls GET /api/notifications/process with
# `Authorization: Bearer ${CRON_SECRET}` on the vercel.json schedule. Server-only.
CRON_SECRET=

# --- Transactional mail + bug-report notifications ----------------------------
# ALL SERVER-ONLY secrets (NO NEXT_PUBLIC_ prefix -> never sent to the browser).
# They are read only by `src/lib/mail/*`, which is marked `import "server-only"`
# so the build fails if it is ever pulled into client code.
#
# EVERY value here degrades GRACEFULLY: a missing one means the notification is
# skipped and a short reason is logged. A bug report is ALWAYS saved first and
# its success never depends on the mail going out — losing a report to a mail
# outage is the one failure this feature must not have.
#
# Brevo transactional API key (sent as the `api-key` header). Empty = mail off.
BREVO_API_KEY=
# The VERIFIED sender address in your Brevo account. Empty = mail off.
BREVO_SENDER_EMAIL=
# Display name on outgoing mail. Empty = "OlympIQ".
BREVO_SENDER_NAME=
# Who receives new bug reports — comma-separated. Empty = no notification sent.
BUG_REPORT_NOTIFY_EMAIL=
# Admin panel origin, NO trailing slash (e.g. https://admin.olympiq.ai). Used
# only to build the "open in admin" deep link. Empty = the link line is omitted
# rather than a broken URL emitted. Never derived from a request header.
ADMIN_PANEL_URL=
# Salt for the anonymous bug-report throttle key. The visitor's IP is hashed
# with this and kept ONLY in the in-memory rate-limit map — no IP is ever
# written to the database or to a log. Empty = a random per-process value
# (the throttle still works; it resets on restart).
BUG_REPORT_IP_SALT=
