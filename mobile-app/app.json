{
  "expo": {
    "name": "OlympIQ",
    "slug": "olympiq",
    "version": "1.15.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "olympiq",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "locales": {
      "az": "./locales/az.json",
      "en": "./locales/en.json",
      "ru": "./locales/ru.json"
    },
    "ios": {
      "bundleIdentifier": "ai.olympiq.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSPhotoLibraryUsageDescription": "OlympIQ uses this only when you choose a profile picture — for example, picking a photo for your child's profile so they can recognise their own account. The photo is stored only as a profile image and is never used for anything else.",
        "NSCameraUsageDescription": "OlympIQ uses this only for profile pictures — for example, adding a photo to your child's profile so they can recognise their own account. Photos are stored only as a profile image and are never used for anything else.",
        "CFBundleLocalizations": [
          "az",
          "en",
          "ru"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.olympiq.app",
      "adaptiveIcon": {
        "backgroundColor": "#141B4D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffbf5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#14101f"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#7c3aed"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OlympIQ Face ID-dən yalnız tətbiqin kilidini açmaq üçün istifadə edir — bunu özünüz Hesab bölməsində aktivləşdirirsiniz. Üz məlumatları qurğunuzu heç vaxt tərk etmir."
        }
      ],
      "./plugins/withIosPermissionStringDefaults",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "786a0358-d1db-437e-9fa3-b466b490a8ae"
      }
    },
    "owner": "olimpiadaplatforms-team",
    "updates": {
      "url": "https://u.expo.dev/786a0358-d1db-437e-9fa3-b466b490a8ae"
    }
  }
}
